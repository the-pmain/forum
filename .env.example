PORT=3001
NODE_ENV=development

# Comma-separated client IPs. Any other address is refused (pages and API).
ALLOWED_ADDRESSES="185.238.203.103"

# HMAC cookie session (required in production)
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_PASS=password123$

# Supabase PostgREST (HTTP, no supabase-js) — comments only, not the directory
# Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Optional: direct Postgres (SQL editor / migrations). The app itself uses PostgREST.
DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
SUPABASE_DB_PASSWORD=YOUR-DB-PASSWORD
